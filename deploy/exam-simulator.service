[Unit]
Description=Examinator — IT certification exam simulator
Documentation=file:///opt/exam-simulator/README.md
After=network-online.target local-fs.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/exam-simulator
Environment=PYTHONPATH=/opt/exam-simulator
ExecStart=/opt/exam-simulator/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
TimeoutStartSec=120
KillMode=mixed

[Install]
WantedBy=multi-user.target
