# Examinator — example environment file
# Copy to `.env` and adjust values for your deployment.
# Prefer: sudo ./scripts/install_examinator.sh (creates .env automatically).

APP_NAME=Examinator
DATABASE_URL=sqlite:////opt/exam-simulator/data/exams.db
SECRET_KEY=change-me-to-a-long-random-string
QUESTIONS_PER_SESSION=50
SESSION_COOKIE=certsim_user_id
ADMIN_EMAIL=admin@example.com

# Public site URL used in e-mails (leave empty to omit links)
PUBLIC_URL=

# E-mail broadcast via Microsoft Graph (Entra app registration, application permission Mail.Send)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
MAIL_SENDER=info@example.com
